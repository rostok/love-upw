diff --git a/src/modules/love/love.cpp b/src/modules/love/love.cpp
index 0202a852..6a5f551b 100644
--- a/src/modules/love/love.cpp
+++ b/src/modules/love/love.cpp
@@ -554,6 +554,65 @@ int luaopen_love(lua_State *L)
 	});
 #endif
 
+#ifdef LOVE_WINDOWS_UWP
+	// love.progress(text, value) for love-uwp: a game calls it while it loads
+	// for a long time on the main thread. It draws the text and a bar (value
+	// 0..1) or a step number (value > 1), presents the frame and pumps window
+	// events so Windows does not consider the app hung. Desktop LÖVE has no
+	// such function, so games call it as `(love.progress or function() end)`.
+	static const char progress_lua[] = R"lua(
+local love = ...
+local lastDraw = -1
+local function draw(text, value)
+	local g, timer = love.graphics, love.timer
+	if not (g and timer and g.isActive and g.isActive()) then return end
+	local now = timer.getTime()
+	if now - lastDraw < 1 / 30 then return end
+	lastDraw = now
+	local style = love.progressStyle or {}
+	-- reset() also unbinds the game's Canvas, which love.event.pump requires;
+	-- pop() puts the game's graphics state back afterwards.
+	g.push("all")
+	g.reset()
+	if love.event then love.event.pump() end
+	g.clear(style.background or { 0.06, 0.07, 0.09, 1 })
+	local font = style.font or g.getFont()
+	g.setFont(font)
+	g.setColor(style.color or { 1, 1, 1, 1 })
+	local w, h = g.getDimensions()
+	local y = math.floor(h * 0.55)
+	if text ~= nil then
+		g.printf(tostring(text), 0, y - font:getHeight() * 2, w, "center")
+	end
+	if type(value) == "number" then
+		if value <= 1 then
+			local bw, bh = math.floor(w * 0.5), math.max(4, math.floor(h * 0.012))
+			local bx = math.floor((w - bw) / 2)
+			g.setLineWidth(1)
+			g.rectangle("line", bx - 3, y - 3, bw + 6, bh + 6)
+			g.rectangle("fill", bx, y, bw * math.min(1, math.max(0, value)), bh)
+		else
+			g.printf(string.format("%d", value), 0, y, w, "center")
+		end
+	end
+	g.present()
+	g.pop()
+end
+function love.progress(text, value)
+	-- Never let a progress display break the game's loading.
+	local ok, err = pcall(draw, text, value)
+	if not ok then print("love.progress: " .. tostring(err)) end
+end
+)lua";
+	if (luaL_loadbuffer(L, progress_lua, sizeof(progress_lua) - 1, "=[love-uwp \"progress.lua\"]") == 0)
+	{
+		lua_pushvalue(L, -2);
+		lua_call(L, 1, 0);
+	}
+	else
+		lua_pop(L, 1);
+#endif
+
 	return 1;
 }
 
diff --git a/src/modules/window/sdl/UWPEGL.cpp b/src/modules/window/sdl/UWPEGL.cpp
index e78d3298..75d21421 100644
--- a/src/modules/window/sdl/UWPEGL.cpp
+++ b/src/modules/window/sdl/UWPEGL.cpp
@@ -20,9 +20,11 @@ std::optional<EGLSurfaceSize> getEGLSurfaceSize()
 	constexpr EGLint EGL_HEIGHT = 0x3056;
 	constexpr EGLint EGL_DRAW = 0x3059;
 
-	using GetCurrentDisplay = EGLDisplay (*)();
-	using GetCurrentSurface = EGLSurface (*)(EGLint);
-	using QuerySurface = EGLBoolean (*)(EGLDisplay, EGLSurface, EGLint, EGLint *);
+	// EGL entry points are __stdcall (EGLAPIENTRY) on Windows; on x86 a
+	// default (cdecl) pointer type corrupts the stack.
+	using GetCurrentDisplay = EGLDisplay (__stdcall *)();
+	using GetCurrentSurface = EGLSurface (__stdcall *)(EGLint);
+	using QuerySurface = EGLBoolean (__stdcall *)(EGLDisplay, EGLSurface, EGLint, EGLint *);
 
 	static void *library = SDL_LoadObject("libEGL.dll");
 	if (!library)
@@ -49,6 +51,47 @@ std::optional<EGLSurfaceSize> getEGLSurfaceSize()
 	return EGLSurfaceSize{width, height};
 }
 
+namespace
+{
+
+// The surface size shouldReannounceSurfaceSize last reported as differing
+// from the prediction. From then on that size is trusted over the prediction,
+// so a wrong prediction causes one extra resize, not one every frame.
+EGLSurfaceSize reannouncedSize = {0, 0};
+
+} // anonymous namespace
+
+void getSurfacePixelSize(int windowWidth, int windowHeight, int &pixelWidth, int &pixelHeight)
+{
+	// SDL's WinRT backend reports the window size in physical pixels, rounded
+	// the same way ANGLE sizes its CoreWindow swap chain, so the window size
+	// is the size the surface will have after the next present.
+	auto actual = getEGLSurfaceSize();
+	bool trustActual = actual && actual->width == reannouncedSize.width
+		&& actual->height == reannouncedSize.height;
+
+	if (!trustActual && windowWidth > 0 && windowHeight > 0)
+		actual = EGLSurfaceSize{windowWidth, windowHeight};
+
+	if (actual)
+	{
+		pixelWidth = actual->width;
+		pixelHeight = actual->height;
+	}
+}
+
+bool shouldReannounceSurfaceSize(int pixelWidth, int pixelHeight)
+{
+	auto actual = getEGLSurfaceSize();
+	if (!actual || (actual->width == pixelWidth && actual->height == pixelHeight))
+		return false;
+	if (actual->width == reannouncedSize.width && actual->height == reannouncedSize.height)
+		return false;
+
+	reannouncedSize = *actual;
+	return true;
+}
+
 } // sdl
 } // window
 } // love
diff --git a/src/modules/window/sdl/UWPEGL.h b/src/modules/window/sdl/UWPEGL.h
