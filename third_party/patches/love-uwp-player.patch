--- a/src/modules/window/sdl/UWPEGL.h
+++ b/src/modules/window/sdl/UWPEGL.h
@@ -17,6 +17,16 @@ struct EGLSurfaceSize
 
 std::optional<EGLSurfaceSize> getEGLSurfaceSize();
 
+// Sets the drawable size for a window size (physical pixels, as SDL's WinRT
+// backend reports it). ANGLE only resizes its CoreWindow swap chain on the
+// next present, so right after a resize the EGL surface is stale; this
+// predicts the size ANGLE will use instead.
+void getSurfacePixelSize(int windowWidth, int windowHeight, int &pixelWidth, int &pixelHeight);
+
+// True, once per surface size, when the EGL surface differs from the drawable
+// size last set by getSurfacePixelSize, i.e. the prediction was wrong.
+bool shouldReannounceSurfaceSize(int pixelWidth, int pixelHeight);
+
 } // sdl
 } // window
 } // love
