# Reads games/<game>/player.json and turns it into the APPX_* variables used
# by host/AppxManifest.xml.in, plus GAME_ARCHIVE and GAME_ASSETS_DIR.

# Capabilities that live in the uap namespace; everything else is a
# foundation <Capability>.
set(_LOVE_UWP_UAP_CAPABILITIES
    blockedChatMessages chat musicLibrary objects3D picturesLibrary
    removableStorage userAccountInformation videosLibrary voipCall)

function(_love_uwp_json_get out json key fallback)
    string(JSON value ERROR_VARIABLE missing GET "${json}" "${key}")
    if(missing)
        if(fallback STREQUAL "REQUIRED")
            message(FATAL_ERROR "player.json: \"${key}\" is required")
        endif()
        set(value "${fallback}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(_love_uwp_xml out text)
    string(REPLACE "&" "&amp;" text "${text}")
    string(REPLACE "<" "&lt;" text "${text}")
    string(REPLACE ">" "&gt;" text "${text}")
    string(REPLACE "\"" "&quot;" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# love_uwp_read_config(<game dir> <version override or empty>)
function(love_uwp_read_config game_dir version_override)
    set(config_file "${game_dir}/player.json")
    if(NOT EXISTS "${config_file}")
        message(FATAL_ERROR "No player.json in ${game_dir}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${config_file}")
    file(READ "${config_file}" json)

    _love_uwp_json_get(name         "${json}" identityName "REQUIRED")
    _love_uwp_json_get(publisher    "${json}" publisher "REQUIRED")
    _love_uwp_json_get(publisher_dn "${json}" publisherDisplayName "REQUIRED")
    _love_uwp_json_get(display_name "${json}" displayName "REQUIRED")
    _love_uwp_json_get(description  "${json}" description "${display_name}")
    _love_uwp_json_get(version      "${json}" version "1.0.0")
    _love_uwp_json_get(background   "${json}" backgroundColor "#000000")
    _love_uwp_json_get(min_os       "${json}" minVersion "10.0.19041.0")
    _love_uwp_json_get(max_tested   "${json}" maxVersionTested "10.0.26100.0")
    _love_uwp_json_get(archive      "${json}" game "game.love")
    _love_uwp_json_get(assets       "${json}" assets "")
    _love_uwp_json_get(screen_kbd   "${json}" screenKeyboard "OFF")

    if(version_override)
        set(version "${version_override}")
    endif()
    if(NOT version MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
        message(FATAL_ERROR "Version '${version}' is not X.Y.Z")
    endif()
    foreach(part ${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3})
        if(part GREATER 65535)
            message(FATAL_ERROR "Version '${version}': each number must be <= 65535")
        endif()
    endforeach()
    if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9.-]*$")
        message(FATAL_ERROR "identityName '${name}' may only use letters, digits, '.' and '-'")
    endif()

    # Capabilities: default keeps the network and LuaJIT's JIT working.
    string(JSON count ERROR_VARIABLE no_caps LENGTH "${json}" capabilities)
    if(no_caps)
        set(capabilities internetClient codeGeneration)
    else()
        set(capabilities "")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(i RANGE ${last})
                string(JSON cap GET "${json}" capabilities ${i})
                list(APPEND capabilities "${cap}")
            endforeach()
        endif()
    endif()
    set(cap_lines "")
    foreach(cap IN LISTS capabilities)
        if(NOT cap MATCHES "^[A-Za-z0-9]+$")
            message(FATAL_ERROR "player.json: bad capability name '${cap}'")
        endif()
        if(cap IN_LIST _LOVE_UWP_UAP_CAPABILITIES)
            list(APPEND cap_lines "    <uap:Capability Name=\"${cap}\" />")
        else()
            list(APPEND cap_lines "    <Capability Name=\"${cap}\" />")
        endif()
    endforeach()
    list(JOIN cap_lines "\n" cap_xml)

    # Stable fake phone product id derived from the identity name.
    string(UUID phone_id NAMESPACE 3c6a8f0e-2b1d-4f7a-9c55-6e0b8d4a1f23 NAME "${name}" TYPE SHA1)

    _love_uwp_xml(APPX_NAME "${name}")
    _love_uwp_xml(APPX_PUBLISHER "${publisher}")
    _love_uwp_xml(APPX_PUBLISHER_DISPLAY_NAME "${publisher_dn}")
    _love_uwp_xml(APPX_DISPLAY_NAME "${display_name}")
    _love_uwp_xml(APPX_DESCRIPTION "${description}")
    _love_uwp_xml(APPX_BACKGROUND "${background}")

    set(APPX_NAME "${APPX_NAME}" PARENT_SCOPE)
    set(APPX_PUBLISHER "${APPX_PUBLISHER}" PARENT_SCOPE)
    set(APPX_PUBLISHER_DISPLAY_NAME "${APPX_PUBLISHER_DISPLAY_NAME}" PARENT_SCOPE)
    set(APPX_DISPLAY_NAME "${APPX_DISPLAY_NAME}" PARENT_SCOPE)
    set(APPX_DESCRIPTION "${APPX_DESCRIPTION}" PARENT_SCOPE)
    set(APPX_BACKGROUND "${APPX_BACKGROUND}" PARENT_SCOPE)
    set(APPX_VERSION "${version}.0" PARENT_SCOPE)
    set(APPX_MIN_VERSION "${min_os}" PARENT_SCOPE)
    set(APPX_MAX_VERSION_TESTED "${max_tested}" PARENT_SCOPE)
    set(APPX_PHONE_ID "${phone_id}" PARENT_SCOPE)
    set(APPX_CAPABILITIES "${cap_xml}" PARENT_SCOPE)

    cmake_path(ABSOLUTE_PATH archive BASE_DIRECTORY "${game_dir}" OUTPUT_VARIABLE archive)
    set(GAME_ARCHIVE "${archive}" PARENT_SCOPE)
    if(assets)
        cmake_path(ABSOLUTE_PATH assets BASE_DIRECTORY "${game_dir}" OUTPUT_VARIABLE assets)
    endif()
    set(GAME_ASSETS_DIR "${assets}" PARENT_SCOPE)
    # JSON true/false arrive as ON/OFF.
    if(screen_kbd)
        set(GAME_SCREEN_KEYBOARD 1 PARENT_SCOPE)
    else()
        set(GAME_SCREEN_KEYBOARD 0 PARENT_SCOPE)
    endif()
endfunction()
